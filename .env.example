# Meeting Recorder가 읽는 환경 변수 (모두 선택). 값은 비워 두고 이 파일은 예시로만 둔다.
# 앱은 .env 파일을 자동으로 읽지 않는다 — 개발 실행 때 셸에서 넘긴다: `set -a; source .env; set +a; npm start`
# 실제 값을 넣은 .env는 .gitignore로 커밋되지 않는다. 키는 가능하면 앱 설정 › 계정·토큰에 넣는다 (macOS 키체인으로 암호화해 저장).

# Anthropic API 키: 다듬기·회의록에 API를 쓸 때, 설정에 키를 넣지 않았으면 이 값을 쓴다
# (기본은 이미 로그인된 Claude Code·Codex를 쓰므로 없어도 된다)
ANTHROPIC_API_KEY=

# whisper-server 실행 파일 경로: Homebrew 기본 위치(/opt/homebrew/bin, /usr/local/bin)가 아닐 때만
WHISPER_SERVER=

# 화상 회의 상대방 소리(시스템 오디오)를 받을 장치 id: 기본 'loopbackAllDevices'와 다를 때만
LOOPBACK_ID=

# 개발 실행에서 2.5초 뒤 메인 창을 이 경로에 PNG로 캡처 (설치한 앱에서는 무시)
SCREENSHOT=
