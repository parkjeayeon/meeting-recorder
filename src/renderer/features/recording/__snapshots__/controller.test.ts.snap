exports[`recording characterization > captures meeting sheet choices and awaits settings before remember, speakers, close and toggle 1`] = `
[
  {
    "focus": "startYes",
    "html": "<dialog class="sheet" id="meetStart" aria-labelledby="meetStartTitle" open="">
    <header class="sheet-head">
      <span class="sheet-mark"><svg><use href="#i-rec"></use></svg></span>
      <div>
        <h3 id="meetStartTitle">회의 녹음 시작</h3>
        <p>시작한 뒤에도 일시정지하거나 취소할 수 있습니다.</p>
      </div>
      <button class="icon-btn" id="startClose" aria-label="닫기"><svg><use href="#i-x"></use></svg></button>
    </header>
    <section class="sheet-sec">
      <div class="sheet-label"><b>참석 인원</b><span>알려 주면 누가 말했는지 더 정확하게 나눕니다</span></div>
      <div class="segbar" id="startSpeakers" role="radiogroup" aria-label="참석 인원"><button type="button" role="radio" data-n="" aria-checked="true">자동</button><button type="button" role="radio" data-n="2" aria-checked="false">2명</button><button type="button" role="radio" data-n="3" aria-checked="false">3명</button><button type="button" role="radio" data-n="4" aria-checked="false">4명</button><button type="button" role="radio" data-n="5" aria-checked="false">5명</button><button type="button" role="radio" data-n="6" aria-checked="false">6명</button><button type="button" role="radio" data-n="7" aria-checked="false">7명</button><button type="button" role="radio" data-n="8" aria-checked="false">8명</button></div>
    </section>
    <section class="sheet-sec">
      <div class="sheet-label"><b>회의 방식</b></div>
      <div class="kinds" id="startKind" role="radiogroup" aria-label="회의 방식">
        <button type="button" role="radio" data-kind="offline" aria-checked="true"><svg><use href="#i-people"></use></svg><b>대면 회의</b><span>이 Mac 마이크로만 녹음</span></button>
        <button type="button" role="radio" data-kind="online" aria-checked="false"><svg><use href="#i-mic"></use></svg><b>화상 회의</b><span>상대방 소리(시스템 오디오)도 함께</span></button>
      </div>
    </section>
    <footer class="sheet-foot">
      <label class="inline-switch"><span class="switch"><input type="checkbox" id="startMinutes"><i></i></span>끝나면 회의록 만들기</label>
      <button class="btn" id="startNo">닫기</button>
      <button class="btn rec" id="startYes"><svg><use href="#i-rec"></use></svg>녹음 시작</button>
    </footer>
  </dialog>",
    "minutes": true,
  },
